{
  "name": "numeros-em-acao",
  "version": "1.0.0",
  "description": "Aplicação educacional de matemática para crianças",
  "type": "module",
  "scripts": {
    "dev": "node src/api/server.js",
    "start": "node src/api/server.js",
    "build:css": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/css/input.css -o ./src/css/output.css --watch",
    "test": "node --test"
