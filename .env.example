# Aplicação: também configurar estas variáveis na Vercel.
APP_URL=https://seu-dominio.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Para TLS use a CA em arquivo local ou em uma variável na Vercel.
MYSQL_CA_PATH=
MYSQL_CA_PEM=
# Somente se a conexão sem criptografia tiver sido explicitamente autorizada.
MYSQL_ALLOW_INSECURE=false

PORT=3000
